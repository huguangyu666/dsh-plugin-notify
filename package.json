{
  "name": "dsh-plugin-notify",
  "version": "0.1.1",
  "description": "DeepSeek Harness 插件：通知出口——agent 通过桌面通知 / 中文语音播报 / 提示音主动联系用户（长任务完成、出错、呼叫用户回来）。Windows 本机零依赖。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "notify.ps1",
    "idle.ps1",
    "volume.py",
    "sound.py",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "notify",
    "notification",
    "tts",
    "voice",
    "alert"
  ],
  "license": "MIT",
  "author": "huguangyu666",
  "repository": {
    "type": "git",
    "url": "https://github.com/huguangyu666/dsh-plugin-notify.git"
  },
  "engines": {
    "node": ">=22.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.0-rc.6",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
